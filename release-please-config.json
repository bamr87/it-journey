{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Added"
        },
        {
          "type": "fix",
          "section": "Fixed"
        },
        {
          "type": "perf",
          "section": "Changed"
        },
        {
          "type": "refactor",
          "section": "Changed"
        },
        {
          "type": "revert",
          "section": "Removed"
        },
        {
          "type": "deps",
          "section": "Changed"
        },
        {
          "type": "docs",
          "section": "Documentation",
          "hidden": false
        },
        {
          "type": "style",
          "section": "Miscellaneous",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Miscellaneous",
          "hidden": true
        },
        {
          "type": "test",
          "section": "Miscellaneous",
          "hidden": true
        },
        {
          "type": "ci",
          "section": "Miscellaneous",
          "hidden": true
        },
        {
          "type": "build",
          "section": "Miscellaneous",
          "hidden": true
        }
      ]
    }
  }
}
