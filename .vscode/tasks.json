// it-journey · .vscode/tasks.json — fleet-vscode/v1 · 2026-09-09. Convention + vocabulary: .vscode/README.md.
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve",
      "detail": "Docker. The Jekyll dev server (_config.yml,_config_dev.yml) on http://localhost:4002. Runs until Stop.",
      "type": "shell",
      "command": "docker compose up jekyll",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "serve",
        "pattern": {
          "regexp": "^(never-matches)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Server (running|address)|Container \\S+\\s+Running"
        }
      }
    },
    {
      "label": "Stop",
      "detail": "Stops and removes the dev stack (docker compose down).",
      "type": "shell",
      "command": "docker compose down",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build",
      "detail": "Docker. The dev-config Jekyll build inside the container.",
      "type": "shell",
      "command": "docker compose up -d jekyll && docker compose exec -T jekyll bundle exec jekyll build --config _config.yml,_config_dev.yml",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Lint",
      "detail": "Host python. The pre-build checks build-validation.yml runs: Liquid raw-guards, then the content audit (frontmatter, mermaid, quests, quest network).",
      "type": "shell",
      "command": "make liquid-check && make content-audit",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Verify",
      "detail": "Lint, then Build — build-validation.yml's checks in order.",
      "dependsOn": [
        "Lint",
        "Build"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Quest: audit (Docker)",
      "detail": "Docker (python:3.12-slim). The quest audit exactly as CI runs it; EXTRA=… passes flags through.",
      "type": "shell",
      "command": "make docker-validate",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Fix: unwrap prose",
      "detail": "Host python. Rewrites soft-wrapped markdown to one paragraph per line (the markdown-oneline gate). Diff before you commit.",
      "type": "shell",
      "command": "make prose-oneline-apply",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CMS: status",
      "detail": "Host. The content-health dashboard by collection.",
      "type": "shell",
      "command": "make cms-status",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: rebuild",
      "detail": "Force-rebuilds and recreates the stack (after Dockerfile / compose changes).",
      "type": "shell",
      "command": "docker compose up --build --force-recreate -d jekyll",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: logs",
      "detail": "Follows the jekyll container's logs.",
      "type": "shell",
      "command": "docker compose logs -f jekyll",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Claude: session",
      "detail": "Interactive Claude Code in this repo with its .claude/agents + skills, on your logged-in credentials. House rules still apply: branch from main, open a PR, a human merges.",
      "type": "shell",
      "command": "claude",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      }
    }
  ]
}
